                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterSourceSelections"
                                   value="Bottled Water" />

                            <span>
                                Bottled Water
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterSourceSelections"
                                   value="Mineral Water" />

                            <span>
                                Mineral Water
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterSourceSelections"
                                   value="Distilled Water" />

                            <span>
                                Distilled Water
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   id="otherWaterSourceCheck"
                                   name="Input.WaterSourceSelections"
                                   value="Other" />

                            <span>
                                Other
                            </span>

                        </label>

                    </div>


                    <div id="otherWaterSourceGroup"
                         class="water-other-field">

                        <label asp-for="Input.OtherWaterSource">
                            Specify Other Water Source
                        </label>

                        <input asp-for="Input.OtherWaterSource"
                               id="otherWaterSource"
                               class="form-control"
                               placeholder="Enter the specific water source..." />

                    </div>

                </div>

            </div>


            <!-- WATER TREATMENT -->

            <div class="entry-subsection">

                <div class="entry-subsection-title">
                    Water Treatment
                </div>


                <div class="entry-field">

                    <div class="water-checkbox-grid">


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Boiling" />

                            <span>
                                Boiling
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Chlorination (Water Guard / Aquatab)" />

                            <span>
                                Chlorination (Water Guard / Aquatab)
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Filtration" />

                            <span>
                                Filtration
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Chemical Treatment" />

                            <span>
                                Chemical Treatment
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Distillation" />

                            <span>
                                Distillation
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Purification" />

                            <span>
                                Purification
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Reverse Osmosis" />

                            <span>
                                Reverse Osmosis
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   name="Input.WaterTreatmentSelections"
                                   value="Bottled Water" />

                            <span>
                                Bottled Water
                            </span>

                        </label>


                        <label class="water-checkbox-item">

                            <input type="checkbox"
                                   id="otherWaterTreatmentCheck"
                                   name="Input.WaterTreatmentSelections"
                                   value="Other" />

                            <span>
                                Other
                            </span>

                        </label>

                    </div>


                    <div id="otherWaterTreatmentGroup"
                         class="water-other-field">

                        <label asp-for="Input.OtherWaterTreatment">
                            Specify Other Water Treatment
                        </label>

                        <input asp-for="Input.OtherWaterTreatment"
                               id="otherWaterTreatment"
                               class="form-control"
                               placeholder="Enter the specific water treatment..." />

                    </div>

                </div>

            </div>

        </section>


        <!-- ==================================================
             ACTIONS
        =================================================== -->

        <div class="create-form-actions">

            <a asp-page="./Index"
               class="btn eps-btn-secondary">
                Cancel
            </a>


            <button type="submit"
                    class="btn eps-btn-primary">
                Save Questionnaire Record
            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                // =================================================
                // SPECIMEN ID → SITE CODE
                // =================================================

                const specimenId =
                    document.getElementById(
                        "specimenId"
                    );

                const siteCode =
                    document.getElementById(
                        "siteCode"
                    );


                function updateSiteCode() {

                    const value =
                        specimenId?.value
                            .trim()
                            .toUpperCase();


                    if (!value || !siteCode) {
                        return;
                    }


                    const parts =
                        value.split("-");


                    if (parts.length === 3) {

                        siteCode.value =
                            parts[1];

                    }

                }


                specimenId?.addEventListener(
                    "input",
                    updateSiteCode
                );


                // =================================================
                // DIARRHEA DURATION
                // =================================================

                const firstSymptom =
                    document.getElementById(
                        "firstSymptom"
                    );

                const diarrheaDurationGroup =
                    document.getElementById(
                        "diarrheaDurationGroup"
                    );


                function updateDiarrheaDuration() {

                    if (!diarrheaDurationGroup) {
                        return;
                    }


                    diarrheaDurationGroup.style.display =
                        firstSymptom?.value === "Diarrhea"
                            ? ""
                            : "none";

                }


                firstSymptom?.addEventListener(
                    "change",
                    updateDiarrheaDuration
                );


                // =================================================
                // BLOODY STOOL
                // =================================================

                const bloodyStool =
                    document.getElementById(
                        "bloodyStool"
                    );

                const bloodyStoolDurationGroup =
                    document.getElementById(
                        "bloodyStoolDurationGroup"
                    );


                function updateBloodyStoolDuration() {

                    if (!bloodyStoolDurationGroup) {
                        return;
                    }


                    bloodyStoolDurationGroup.style.display =
                        bloodyStool?.value === "Yes"
                            ? ""
                            : "none";

                }


                bloodyStool?.addEventListener(
                    "change",
                    updateBloodyStoolDuration
                );


                // =================================================
                // ROTAVIRUS DATE DEPENDENCIES
                // =================================================

                function configureDateDependency(
                    selectId,
                    groupId
                ) {

                    const select =
                        document.getElementById(
                            selectId
                        );

                    const group =
                        document.getElementById(
                            groupId
                        );


                    function update() {

                        if (!group) {
                            return;
                        }


                        group.style.display =
                            select?.value === "Yes"
                                ? ""
                                : "none";

                    }


                    select?.addEventListener(
                        "change",
                        update
                    );


                    update();

                }


                configureDateDependency(
                    "rotavirusDose1Status",
                    "rotavirusDose1DateGroup"
                );


                configureDateDependency(
                    "rotavirusDose2Status",
                    "rotavirusDose2DateGroup"
                );


                configureDateDependency(
                    "otherRotavirusVaccineStatus",
                    "otherRotavirusVaccineDateGroup"
                );


                // =================================================
                // GENERIC SYMPTOM DEPENDENCY
                // =================================================

                function configureSymptom(
                    selectId,
                    detailsId
                ) {

                    const select =
                        document.getElementById(
                            selectId
                        );

                    const details =
                        document.getElementById(
                            detailsId
                        );


                    if (!select || !details) {
                        return;
                    }


                    function update() {

                        details.style.display =
                            select.value === "Yes"
                                ? "grid"
                                : "none";

                    }


                    select.addEventListener(
                        "change",
                        update
                    );


                    update();

                }


                configureSymptom(
                    "abdominalCramps",
                    "abdominalCrampsDetails"
                );

                configureSymptom(
                    "excessiveGas",
                    "excessiveGasDetails"
                );

                configureSymptom(
                    "nausea",
                    "nauseaDetails"
                );

                configureSymptom(
                    "fever",
                    "feverDetails"
                );

                configureSymptom(
                    "painfulStrainingStool",
                    "painfulStrainingDetails"
                );

                configureSymptom(
                    "malaiseFatigue",
                    "malaiseFatigueDetails"
                );

                configureSymptom(
                    "vomiting",
                    "vomitingDetails"
                );

                configureSymptom(
                    "headache",
                    "headacheDetails"
                );

                configureSymptom(
                    "lossOfAppetite",
                    "lossOfAppetiteDetails"
                );

                configureSymptom(
                    "lightheadedness",
                    "lightheadednessDetails"
                );

                configureSymptom(
                    "stoolUrgency",
                    "stoolUrgencyDetails"
                );

                configureSymptom(
                    "muscleAches",
                    "muscleAchesDetails"
                );

                configureSymptom(
                    "jointAches",
                    "jointAchesDetails"
                );

                configureSymptom(
                    "fecalIncontinence",
                    "fecalIncontinenceDetails"
                );

                configureSymptom(
                    "otherSymptoms",
                    "otherSymptomsDetails"
                );

                configureSymptom(
                    "additionalSymptoms",
                    "additionalSymptomsDetails"
                );


                // =================================================
                // CHILD / ADULT ASSESSMENT
                // =================================================

                const ageInput =
                    document.getElementById(
                        "ageInput"
                    );

                const childSection =
                    document.getElementById(
                        "childAssessmentSection"
                    );

                const adultSection =
                    document.getElementById(
                        "adultAssessmentSection"
                    );

                const assessmentNotice =
                    document.getElementById(
                        "assessmentGroupNotice"
                    );


                function determineAssessmentGroup(
                    value
                ) {

                    if (!value) {
                        return "unknown";
                    }


                    const age =
                        value
                            .trim()
                            .toLowerCase();


                    if (
                        age.includes("child") ||
                        age.includes("infant") ||
                        age.includes("baby")
                    ) {

                        return "child";

                    }


                    if (age.includes("adult")) {

                        return "adult";

                    }


                    if (
                        age.includes("month") ||
                        age.includes("week") ||
                        age.includes("day")
                    ) {

                        return "child";

                    }


                    const match =
                        age.match(
                            /(\d+(\.\d+)?)/
                        );


                    if (!match) {
                        return "unknown";
                    }


                    const numericAge =
                        parseFloat(
                            match[1]
                        );


                    if (
                        age.includes("year") ||
                        age.includes("yr") ||
                        age.includes("yrs")
                    ) {

                        return numericAge < 18
                            ? "child"
                            : "adult";

                    }


                    return numericAge < 18
                        ? "child"
                        : "adult";

                }


                function updateAssessmentGroup() {

                    const group =
                        determineAssessmentGroup(
                            ageInput?.value
                        );


                    if (childSection) {

                        childSection.style.display =
                            group === "child"
                                ? ""
                                : "none";

                    }


                    if (adultSection) {

                        adultSection.style.display =
                            group === "adult"
                                ? ""
                                : "none";

                    }


                    if (assessmentNotice) {

                        if (group === "child") {

                            assessmentNotice.textContent =
                                "Child assessment fields are active.";

                        }
                        else if (group === "adult") {

                            assessmentNotice.textContent =
                                "Adult assessment fields are active.";

                        }
                        else {

                            assessmentNotice.textContent =
                                "Enter age in a recognizable format such as 1yr, 6 months, or 25 years.";

                        }

                    }

                }


                ageInput?.addEventListener(
                    "input",
                    updateAssessmentGroup
                );


                // =================================================
                // TREATMENT / ADMISSION PATHWAY
                // =================================================

                const admitted =
                    document.getElementById(
                        "admitted"
                    );

                const outpatientTreatmentSection =
                    document.getElementById(
                        "outpatientTreatmentSection"
                    );

                const admittedTreatmentSection =
                    document.getElementById(
                        "admittedTreatmentSection"
                    );

                const dispositionSection =
                    document.getElementById(
                        "dispositionSection"
                    );


                function updateTreatmentPathway() {

                    const value =
                        admitted?.value;


                    const isOutpatient =
                        value === "No";


                    const isAdmitted =
                        value === "Yes";


                    if (outpatientTreatmentSection) {

                        outpatientTreatmentSection.style.display =
                            isOutpatient
                                ? ""
                                : "none";

                    }


                    if (admittedTreatmentSection) {

                        admittedTreatmentSection.style.display =
                            isAdmitted
                                ? ""
                                : "none";

                    }


                    if (dispositionSection) {

                        dispositionSection.style.display =
                            isAdmitted
                                ? ""
                                : "none";

                    }

                }


                admitted?.addEventListener(
                    "change",
                    updateTreatmentPathway
                );


                // =================================================
                // DISPOSITION DETAILS
                // =================================================

                const disposition =
                    document.getElementById(
                        "disposition"
                    );

                const dispositionDetails =
                    document.getElementById(
                        "dispositionDetails"
                    );


                function updateDispositionDetails() {

                    if (!dispositionDetails) {
                        return;
                    }


                    dispositionDetails.style.display =
                        disposition?.value
                            ? ""
                            : "none";

                }


                disposition?.addEventListener(
                    "change",
                    updateDispositionDetails
                );


                // =================================================
                // OTHER WATER SOURCE
                // =================================================

                const otherWaterSourceCheck =
                    document.getElementById(
                        "otherWaterSourceCheck"
                    );

                const otherWaterSourceGroup =
                    document.getElementById(
                        "otherWaterSourceGroup"
                    );

                const otherWaterSource =
                    document.getElementById(
                        "otherWaterSource"
                    );


                function updateOtherWaterSource() {

                    const checked =
                        otherWaterSourceCheck?.checked === true;


                    if (otherWaterSourceGroup) {

                        otherWaterSourceGroup.style.display =
                            checked
                                ? ""
                                : "none";

                    }


                    if (
                        !checked &&
                        otherWaterSource
                    ) {

                        otherWaterSource.value =
                            "";

                    }

                }


                otherWaterSourceCheck?.addEventListener(
                    "change",
                    updateOtherWaterSource
                );


                // =================================================
                // OTHER WATER TREATMENT
                // =================================================

                const otherWaterTreatmentCheck =
                    document.getElementById(
                        "otherWaterTreatmentCheck"
                    );

                const otherWaterTreatmentGroup =
                    document.getElementById(
                        "otherWaterTreatmentGroup"
                    );

                const otherWaterTreatment =
                    document.getElementById(
                        "otherWaterTreatment"
                    );


                function updateOtherWaterTreatment() {

                    const checked =
                        otherWaterTreatmentCheck?.checked === true;


                    if (otherWaterTreatmentGroup) {

                        otherWaterTreatmentGroup.style.display =
                            checked
                                ? ""
                                : "none";

                    }


                    if (
                        !checked &&
                        otherWaterTreatment
                    ) {

                        otherWaterTreatment.value =
                            "";

                    }

                }


                otherWaterTreatmentCheck?.addEventListener(
                    "change",
                    updateOtherWaterTreatment
                );


                // =================================================
                // INITIAL STATE
                // =================================================

                updateSiteCode();

                updateDiarrheaDuration();

                updateBloodyStoolDuration();

                updateAssessmentGroup();

                updateTreatmentPathway();

                updateDispositionDetails();

                updateOtherWaterSource();

                updateOtherWaterTreatment();

            }
        );

    </script>

}