@page
@model global::EPS_Web_App.Pages.Questionnaire.CreateModel

@{
    ViewData["Title"] = "New Questionnaire";
}

<div class="questionnaire-create-page">

    <div class="create-header">

        <div>

            <div class="module-eyebrow">
                QUESTIONNAIRE DATA ENTRY
            </div>

            <h1 class="module-title">
                New Surveillance Record
            </h1>

            <p class="module-description">
                Complete the questionnaire in sequence.
                Fields that do not apply will be hidden automatically.
            </p>

        </div>

        <div>

            <a asp-page="./Index"
               class="btn eps-btn-secondary">
                ← Cancel
            </a>

        </div>

    </div>


    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <form method="post"
          id="questionnaireForm">

        <!-- ==================================================
             SECTION 01 — RECORD IDENTITY
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    01
                </div>

                <div>

                    <div class="entry-section-kicker">
                        IDENTIFICATION
                    </div>

                    <h2>
                        Record Identity
                    </h2>

                    <p>
                        Establish the surveillance record and core identifiers.
                    </p>

                </div>

            </div>


            <div class="entry-grid entry-grid-3">

                <div class="entry-field entry-field-wide">

                    <label asp-for="Input.SpecimenId">
                        Specimen ID
                        <span class="required-mark">*</span>
                    </label>

                    <input asp-for="Input.SpecimenId"
                           id="specimenId"
                           class="form-control form-control-lg"
                           placeholder="EPS1549-KCH-0001A"
                           autocomplete="off" />

                    <div class="field-help">
                        Format: EPS1549-SITE-####A/B
                    </div>

                    <span asp-validation-for="Input.SpecimenId"
                          class="field-error">
                    </span>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.SiteCode">
                        Site Code
                    </label>

                    <input asp-for="Input.SiteCode"
                           id="siteCode"
                           class="form-control"
                           readonly />

                    <div class="field-help">
                        Derived automatically from Specimen ID.
                    </div>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.Lan">
                        LAN
                    </label>

                    <input asp-for="Input.Lan"
                           class="form-control"
                           placeholder="MHK#####"
                           autocomplete="off" />

                    <span asp-validation-for="Input.Lan"
                          class="field-error">
                    </span>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.IsolationDate">
                        Isolation Date
                    </label>

                    <input asp-for="Input.IsolationDate"
                           class="form-control"
                           type="date" />

                </div>

            </div>

        </section>


        <!-- ==================================================
             SECTION 02 — PARTICIPANT
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    02
                </div>

                <div>

                    <div class="entry-section-kicker">
                        PARTICIPANT
                    </div>

                    <h2>
                        Participant Information
                    </h2>

                    <p>
                        Record demographic and participant details.
                    </p>

                </div>

            </div>


            <div class="entry-grid entry-grid-4">

                <div class="entry-field">

                    <label asp-for="Input.Age">
                        Age
                    </label>

                    <input asp-for="Input.Age"
                           id="ageInput"
                           class="form-control"
                           placeholder="e.g. 2 years" />

                    <div class="field-help">
                        Used to determine the applicable clinical assessment.
                    </div>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.DateOfBirth">
                        Date of Birth
                    </label>

                    <input asp-for="Input.DateOfBirth"
                           class="form-control"
                           type="date" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.Gender">
                        Gender
                    </label>

                    <select asp-for="Input.Gender"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Male">
                            Male
                        </option>

                        <option value="Female">
                            Female
                        </option>

                    </select>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.Residence">
                        Residence
                    </label>

                    <input asp-for="Input.Residence"
                           class="form-control" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.Occupation">
                        Occupation
                    </label>

                    <input asp-for="Input.Occupation"
                           class="form-control" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.Rank">
                        Rank
                    </label>

                    <input asp-for="Input.Rank"
                           class="form-control" />

                </div>


                <div class="entry-field entry-field-span-2">

                    <label asp-for="Input.MainJob">
                        Main Job
                    </label>

                    <input asp-for="Input.MainJob"
                           class="form-control" />

                </div>

            </div>

        </section>


        <!-- ==================================================
             SECTION 03 — ROTAVIRUS / HIV
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    03
                </div>

                <div>

                    <div class="entry-section-kicker">
                        BACKGROUND
                    </div>

                    <h2>
                        Rotavirus Vaccination & HIV Status
                    </h2>

                    <p>
                        Record previous rotavirus vaccination and HIV status.
                    </p>

                </div>

            </div>


            <div class="entry-grid entry-grid-3">

                <div class="entry-field">

                    <label asp-for="Input.RotavirusDose1Status">
                        Rotavirus Dose 1 Status
                    </label>

                    <select asp-for="Input.RotavirusDose1Status"
                            id="rotavirusDose1Status"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <div class="entry-field"
                     id="rotavirusDose1DateGroup">

                    <label asp-for="Input.RotavirusDose1Date">
                        Rotavirus Dose 1 Date
                    </label>

                    <input asp-for="Input.RotavirusDose1Date"
                           class="form-control"
                           type="date" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.RotavirusDose2Status">
                        Rotavirus Dose 2 Status
                    </label>

                    <select asp-for="Input.RotavirusDose2Status"
                            id="rotavirusDose2Status"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <div class="entry-field"
                     id="rotavirusDose2DateGroup">

                    <label asp-for="Input.RotavirusDose2Date">
                        Rotavirus Dose 2 Date
                    </label>

                    <input asp-for="Input.RotavirusDose2Date"
                           class="form-control"
                           type="date" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.OtherRotavirusVaccineStatus">
                        Other Rotavirus Vaccine
                    </label>

                    <select asp-for="Input.OtherRotavirusVaccineStatus"
                            id="otherRotavirusVaccineStatus"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <div class="entry-field"
                     id="otherRotavirusVaccineDateGroup">

                    <label asp-for="Input.OtherRotavirusVaccineDate">
                        Other Rotavirus Vaccine Date
                    </label>

                    <input asp-for="Input.OtherRotavirusVaccineDate"
                           class="form-control"
                           type="date" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.HivStatus">
                        HIV Status
                    </label>

                    <select asp-for="Input.HivStatus"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="HIV negative">
                            HIV negative
                        </option>

                        <option value="HIV positive">
                            HIV positive
                        </option>

                        <option value="Unknown">
                            Unknown
                        </option>

                    </select>

                </div>

            </div>

        </section>


        <!-- ==================================================
             SECTION 04 — SYMPTOM ONSET / DIARRHOEA
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    04
                </div>

                <div>

                    <div class="entry-section-kicker">
                        CLINICAL PRESENTATION
                    </div>

                    <h2>
                        Symptom Onset & Diarrhoeal Illness
                    </h2>

                    <p>
                        Establish the onset of illness and document the diarrhoeal presentation.
                    </p>

                </div>

            </div>


            <div class="entry-grid entry-grid-4">

                <div class="entry-field entry-field-span-2">

                    <label asp-for="Input.FirstSymptom">
                        First Symptom
                    </label>

                    <select asp-for="Input.FirstSymptom"
                            id="firstSymptom"
                            class="form-select">

                        <option value="">
                            Select first symptom
                        </option>

                        <option value="Diarrhea">
                            Diarrhea
                        </option>

                        <option value="Fever">
                            Fever
                        </option>

                        <option value="Vomiting">
                            Vomiting
                        </option>

                        <option value="Abdominal cramps">
                            Abdominal cramps
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.SymptomOnsetDate">
                        Symptom Onset Date
                    </label>

                    <input asp-for="Input.SymptomOnsetDate"
                           class="form-control"
                           type="date" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.SymptomOnsetTime">
                        Symptom Onset Time
                    </label>

                    <input asp-for="Input.SymptomOnsetTime"
                           class="form-control"
                           type="time" />

                </div>


                <div class="entry-field entry-field-span-2"
                     id="diarrheaDurationGroup">

                    <label asp-for="Input.DiarrheaDuration">
                        Diarrhea Duration
                    </label>

                    <input asp-for="Input.DiarrheaDuration"
                           class="form-control"
                           placeholder="e.g. 2 days" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.MaxLooseStools24h">
                        Maximum Loose Stools — 24 Hours
                    </label>

                    <input asp-for="Input.MaxLooseStools24h"
                           class="form-control"
                           type="number"
                           min="0" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.LooseStools8h">
                        Loose Stools — 8 Hours
                    </label>

                    <input asp-for="Input.LooseStools8h"
                           class="form-control"
                           type="number"
                           min="0" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.LooseStools24h">
                        Loose Stools — 24 Hours
                    </label>

                    <input asp-for="Input.LooseStools24h"
                           class="form-control"
                           type="number"
                           min="0" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.MucousStool">
                        Mucous Stool
                    </label>

                    <select asp-for="Input.MucousStool"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <div class="entry-field">

                    <label asp-for="Input.BloodyStool">
                        Bloody Stool
                    </label>

                    <select asp-for="Input.BloodyStool"
                            id="bloodyStool"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <div class="entry-field"
                     id="bloodyStoolDurationGroup">

                    <label asp-for="Input.BloodyStoolDuration">
                        Bloody Stool Duration
                    </label>

                    <input asp-for="Input.BloodyStoolDuration"
                           class="form-control" />

                </div>


                <div class="entry-field">

                    <label asp-for="Input.RiceWaterStool">
                        Rice-water Stool
                    </label>

                    <select asp-for="Input.RiceWaterStool"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>

            </div>

        </section>


        <!-- ==================================================
             SECTION 05 — ASSOCIATED SYMPTOMS
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    05
                </div>

                <div>

                    <div class="entry-section-kicker">
                        SYMPTOM ASSESSMENT
                    </div>

                    <h2>
                        Associated Symptoms
                    </h2>

                    <p>
                        Select Yes when a symptom is present.
                        Additional fields appear automatically.
                    </p>

                </div>

            </div>


            <div class="entry-dependent-grid">

                <!-- ABDOMINAL CRAMPS -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.AbdominalCramps">
                            Abdominal Cramps
                        </label>

                        <select asp-for="Input.AbdominalCramps"
                                id="abdominalCramps"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="abdominalCrampsDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.AbdominalCrampsDuration">
                                Duration
                            </label>

                            <input asp-for="Input.AbdominalCrampsDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.AbdominalCrampsSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.AbdominalCrampsSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- EXCESSIVE GAS -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.ExcessiveGas">
                            Excessive Gas
                        </label>

                        <select asp-for="Input.ExcessiveGas"
                                id="excessiveGas"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="excessiveGasDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.ExcessiveGasDuration">
                                Duration
                            </label>

                            <input asp-for="Input.ExcessiveGasDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.ExcessiveGasSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.ExcessiveGasSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- NAUSEA -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.Nausea">
                            Nausea
                        </label>

                        <select asp-for="Input.Nausea"
                                id="nausea"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="nauseaDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.NauseaDuration">
                                Duration
                            </label>

                            <input asp-for="Input.NauseaDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.NauseaSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.NauseaSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- FEVER -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.Fever">
                            Fever
                        </label>

                        <select asp-for="Input.Fever"
                                id="fever"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="feverDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.FeverDuration">
                                Duration
                            </label>

                            <input asp-for="Input.FeverDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.FeverSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.FeverSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- PAINFUL STRAINING -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.PainfulStrainingStool">
                            Painful Straining During Stool
                        </label>

                        <select asp-for="Input.PainfulStrainingStool"
                                id="painfulStrainingStool"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="painfulStrainingDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.PainfulStrainingDuration">
                                Duration
                            </label>

                            <input asp-for="Input.PainfulStrainingDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.PainfulStrainingSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.PainfulStrainingSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- MALAISE -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.MalaiseFatigue">
                            Malaise / Fatigue
                        </label>

                        <select asp-for="Input.MalaiseFatigue"
                                id="malaiseFatigue"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="malaiseFatigueDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.MalaiseFatigueDuration">
                                Duration
                            </label>

                            <input asp-for="Input.MalaiseFatigueDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.MalaiseFatigueSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.MalaiseFatigueSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- VOMITING -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.Vomiting">
                            Vomiting
                        </label>

                        <select asp-for="Input.Vomiting"
                                id="vomiting"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="vomitingDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.VomitingDuration">
                                Duration
                            </label>

                            <input asp-for="Input.VomitingDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.VomitingCount">
                                Number of Vomits
                            </label>

                            <input asp-for="Input.VomitingCount"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.VomitingSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.VomitingSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- HEADACHE -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.Headache">
                            Headache
                        </label>

                        <select asp-for="Input.Headache"
                                id="headache"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="headacheDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.HeadacheDuration">
                                Duration
                            </label>

                            <input asp-for="Input.HeadacheDuration"
                                   class="form-control" />

                        </div>


                        <div class="entry-field">

                            <label asp-for="Input.HeadacheSeverity">
                                Severity
                            </label>

                            <select asp-for="Input.HeadacheSeverity"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Mild">Mild</option>
                                <option value="Moderate">Moderate</option>
                                <option value="Severe">Severe</option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- LOSS OF APPETITE -->

                <div class="dependent-question">

                    <div class="entry-field">

                        <label asp-for="Input.LossOfAppetite">
                            Loss of Appetite
                        </label>

                        <select asp-for="Input.LossOfAppetite"
                                id="lossOfAppetite"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>

                        </select>

                    </div>


                    <div id="lossOfAppetiteDetails"
                         class="dependent-details">

                        <div class="entry-field">

                            <label asp-for="Input.LossOfAppetiteDuration">
                                Duration
                            </label>

                            <input asp-for="Input.LossOfAppetiteDuration"
                                   class="form-control" />

                        </div>

                    </div>

