        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SECTION 06
                </div>

                <h2>
                    Clinical Assessment
                </h2>

            </div>

        </div>


        <div class="record-info-grid">

            <div class="record-info-item">
                <span>General Condition</span>
                <strong>@Display(Model.Record.GeneralCondition)</strong>
            </div>

            <div class="record-info-item">
                <span>Body Temperature</span>
                <strong>@Display(Model.Record.BodyTemperature)</strong>
            </div>

            <div class="record-info-item">
                <span>Body Weight</span>
                <strong>@Display(Model.Record.BodyWeight)</strong>
            </div>

            <div class="record-info-item">
                <span>Height</span>
                <strong>@Display(Model.Record.Height)</strong>
            </div>

            <div class="record-info-item">
                <span>Blood Pressure</span>
                <strong>@Display(Model.Record.BloodPressure)</strong>
            </div>

            <div class="record-info-item">
                <span>Respiratory Rate</span>
                <strong>@Display(Model.Record.RespiratoryRate)</strong>
            </div>

            <div class="record-info-item">
                <span>Malnutrition Status</span>
                <strong>@Display(Model.Record.MalnutritionStatus)</strong>
            </div>

        </div>


        <div class="record-stat-row">

            <div class="record-stat-card">

                <span>
                    CHILD ASSESSMENT
                </span>

                <strong>
                    @(
                        string.IsNullOrWhiteSpace(
                            Model.Record.ChildAssessment)
                            ? "—"
                            : "Recorded"
                    )
                </strong>

            </div>


            <div class="record-stat-card">

                <span>
                    ADULT ASSESSMENT
                </span>

                <strong>
                    @(
                        string.IsNullOrWhiteSpace(
                            Model.Record.PatientClinicalState)
                            ? "—"
                            : "Recorded"
                    )
                </strong>

            </div>

        </div>


        <div class="record-info-grid">

            <div class="record-info-item">
                <span>Child Consciousness Response</span>
                <strong>@Display(Model.Record.ChildConsciousnessResponse)</strong>
            </div>

            <div class="record-info-item">
                <span>Child Restlessness</span>
                <strong>@Display(Model.Record.ChildRestlessness)</strong>
            </div>

            <div class="record-info-item">
                <span>Child Assessment</span>
                <strong>@Display(Model.Record.ChildAssessment)</strong>
            </div>

            <div class="record-info-item">
                <span>Skin Pinch-back</span>
                <strong>@Display(Model.Record.SkinPinchBack)</strong>
            </div>

            <div class="record-info-item">
                <span>Capillary Refill</span>
                <strong>@Display(Model.Record.CapillaryRefill)</strong>
            </div>

            <div class="record-info-item">
                <span>Drinking / Breastfeeding</span>
                <strong>@Display(Model.Record.ChildDrinkingBreastfeeding)</strong>
            </div>

            <div class="record-info-item">
                <span>MUAC</span>
                <strong>@Display(Model.Record.Muac)</strong>
            </div>

            <div class="record-info-item">
                <span>Adult Consciousness Response</span>
                <strong>@Display(Model.Record.AdultConsciousnessResponse)</strong>
            </div>

            <div class="record-info-item">
                <span>Patient Clinical State</span>
                <strong>@Display(Model.Record.PatientClinicalState)</strong>
            </div>

            <div class="record-info-item">
                <span>Illness Functional Impact</span>
                <strong>@Display(Model.Record.IllnessFunctionalImpact)</strong>
            </div>

        </div>

    </section>


    <!-- =========================================================
         SECTION 07 — TREATMENT / MANAGEMENT
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SECTION 07
                </div>

                <h2>
                    Treatment & Management
                </h2>

            </div>

        </div>


        <div class="record-stat-row">

            <div class="record-stat-card">

                <span>
                    CARE PATHWAY
                </span>

                <strong>
                    @(
                        string.Equals(
                            Model.Record.Admitted,
                            "Yes",
                            StringComparison.OrdinalIgnoreCase)
                            ? "Admitted"
                            : string.Equals(
                                Model.Record.Admitted,
                                "No",
                                StringComparison.OrdinalIgnoreCase)
                                ? "Outpatient"
                                : "—"
                    )
                </strong>

            </div>


            <div class="record-stat-card">

                <span>
                    DISPOSITION
                </span>

                <strong>
                    @Display(Model.Record.Disposition)
                </strong>

            </div>

        </div>


        <div class="record-info-grid">

            <div class="record-info-item">
                <span>Outpatient Treatment</span>
                <strong>@Display(Model.Record.OutpatientTreatment)</strong>
            </div>

            <div class="record-info-item">
                <span>Treatment Given</span>
                <strong>@Display(Model.Record.TreatmentGiven)</strong>
            </div>

            <div class="record-info-item">
                <span>Admission Date</span>
                <strong>@DisplayDate(Model.Record.AdmissionDate)</strong>
            </div>

            <div class="record-info-item">
                <span>Admission Time</span>
                <strong>@DisplayTime(Model.Record.AdmissionTime)</strong>
            </div>

            <div class="record-info-item">
