            </div>

            <div class="record-info-item">
                <span>Fever</span>
                <strong>@Display(Model.Record.Fever)</strong>
            </div>

            <div class="record-info-item">
                <span>Fever Duration</span>
                <strong>@Display(Model.Record.FeverDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Fever Severity</span>
                <strong>@Display(Model.Record.FeverSeverity)</strong>
            </div>

            <div class="record-info-item">
                <span>Painful Straining During Stool</span>
                <strong>@Display(Model.Record.PainfulStrainingStool)</strong>
            </div>

            <div class="record-info-item">
