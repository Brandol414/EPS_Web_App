                <strong>@Display(Model.Record.OralRehydration)</strong>
            </div>

            <div class="record-info-item">
                <span>IV Rehydration</span>
                <strong>@Display(Model.Record.IvRehydration)</strong>
            </div>

            <div class="record-info-item">
                <span>Other Treatment</span>
                <strong>@Display(Model.Record.OtherTreatment)</strong>
            </div>

        </div>

    </section>


    <!-- =========================================================
         SECTION 08 — DISPOSITION / OUTCOME
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SECTION 08
                </div>

                <h2>
                    Disposition & Outcome
                </h2>

            </div>

        </div>


        <div class="record-info-grid">

            <div class="record-info-item">
                <span>Disposition</span>
                <strong>@Display(Model.Record.Disposition)</strong>
            </div>

            <div class="record-info-item">
                <span>Disposition Date</span>
                <strong>@DisplayDate(Model.Record.DispositionDate)</strong>
            </div>

            <div class="record-info-item">
                <span>Disposition Time</span>
                <strong>@DisplayTime(Model.Record.DispositionTime)</strong>
            </div>

            <div class="record-info-item">
                <span>Discharge / Death Diagnosis</span>
                <strong>@Display(Model.Record.DischargeDeathDiagnosis)</strong>
            </div>

        </div>

    </section>


    <!-- =========================================================
         SECTION 09 — LABORATORY
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SECTION 09
                </div>

                <h2>
                    Laboratory Identification
                </h2>

            </div>

        </div>


        <div class="pathogen-view-grid">


            <div class="pathogen-view-card pathogen-view-bacterial">

                <div class="pathogen-view-label">
                    BACTERIAL
                </div>

                <div class="pathogen-view-value">

                    @(
                        string.IsNullOrWhiteSpace(
                            Model.Record.BacterialIdentification)
                            ? "No result recorded"
                            : Model.Record.BacterialIdentification
                    )

                </div>

            </div>


            <div class="pathogen-view-card pathogen-view-viral">

                <div class="pathogen-view-label">
                    VIRAL
                </div>

                <div class="pathogen-view-value">

                    @(
                        string.IsNullOrWhiteSpace(
                            Model.Record.ViralIdentification)
                            ? "No result recorded"
                            : Model.Record.ViralIdentification
                    )

                </div>

            </div>


            <div class="pathogen-view-card pathogen-view-parasite">

                <div class="pathogen-view-label">
                    PARASITE
                </div>

                <div class="pathogen-view-value">

                    @(
                        string.IsNullOrWhiteSpace(
                            Model.Record.ParasiteIdentification)
                            ? "No result recorded"
                            : Model.Record.ParasiteIdentification
                    )

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         SECTION 10 — WATER
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SECTION 10
                </div>

                <h2>
                    Water Source & Treatment
                </h2>

            </div>

        </div>


        <div class="record-info-grid">

            <div class="record-info-item">

                <span>
                    Water Source
                </span>

                <strong>
                    @Display(Model.Record.WaterSourceType)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Water Treatment
                </span>

                <strong>
                    @Display(Model.Record.WaterTreatment)
                </strong>

            </div>

        </div>

    </section>


    <!-- =========================================================
         LINKED AST RECORDS
    ========================================================== -->

    <section class="record-section"
             id="linkedRecords">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    LINKED DATA
                </div>

                <h2>
                    Antimicrobial Susceptibility Testing
                </h2>

            </div>

        </div>


        <div class="record-stat-row">

            <div class="record-stat-card">

                <span>
                    LINKED AST RECORDS
                </span>

                <strong>
                    @Model.AstCount
                </strong>

            </div>


            <div class="record-stat-card">

                <span>
                    OPEN RECONCILIATION ALERTS
                </span>

                <strong>
                    @Model.OpenAlertCount
                </strong>

            </div>

        </div>


        @if (Model.AstRecords.Count == 0)
        {
            <div class="record-notice record-notice-neutral">

                <strong>
                    No linked AST records
                </strong>

                <span>
                    No AST record is currently linked to
                    @Model.Record.SpecimenId.
                </span>

            </div>
        }
        else
        {
            <div class="record-subtable">

                <div class="record-subtable-header">

                    <div>
                        AST ID
                    </div>

                    <div>
                        Specimen ID
                    </div>

                    <div>
                        Site
                    </div>

                    <div>
                        LAN
                    </div>

                </div>


                @foreach (var ast in Model.AstRecords)
                {
                    <div class="record-subtable-row">

                        <div>

                            <span class="identifier-chip">
                                @ast.AstRecordId
                            </span>

                        </div>


                        <div class="identifier-text">

                            @(
                                string.IsNullOrWhiteSpace(
                                    ast.SpecimenId)
                                    ? "—"
                                    : ast.SpecimenId
                            )

                        </div>


                        <div>

                            @(
                                string.IsNullOrWhiteSpace(
                                    ast.SiteCode)
                                    ? "—"
                                    : ast.SiteCode
                            )

                        </div>


                        <div>

                            @(
                                string.IsNullOrWhiteSpace(
                                    ast.Lan)
                                    ? "—"
                                    : ast.Lan
                            )

                        </div>

                    </div>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         RECONCILIATION ALERTS
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    DATA QUALITY
                </div>

                <h2>
                    Reconciliation Alerts
                </h2>

            </div>

        </div>


        @if (Model.Alerts.Count == 0)
        {
            <div class="record-notice record-notice-neutral">

                <strong>
                    No reconciliation alerts
                </strong>

                <span>
                    No reconciliation alert is currently recorded for
                    @Model.Record.SpecimenId.
                </span>

            </div>
        }
        else
        {
            <div class="record-alert-list">

                @foreach (var alert in Model.Alerts)
                {
                    var priorityClass =
                        string.Equals(
                            alert.Priority,
                            "Critical",
                            StringComparison.OrdinalIgnoreCase)
                            ||
                        string.Equals(
                            alert.Priority,
                            "High",
                            StringComparison.OrdinalIgnoreCase)
                            ? "alert-high"
                            : string.Equals(
                                alert.Priority,
                                "Medium",
                                StringComparison.OrdinalIgnoreCase)
                                ? "alert-medium"
                                : "alert-low";


                    <div class="record-alert-item">

                        <div class="record-alert-indicator
                            @priorityClass">
                        </div>


                        <div class="record-alert-body">

                            <div class="record-alert-title-row">

                                <strong>
                                    @Display(alert.AlertType)
                                </strong>


                                <span class="record-alert-priority">

                                    @Display(alert.Priority)

                                    ·

                                    @Display(alert.Status)

                                </span>

                            </div>


                            <p>
                                @Display(alert.Description)
                            </p>


                            <div class="record-alert-meta">

                                Created:
                                @Display(alert.CreatedAt)

                                @if (!string.IsNullOrWhiteSpace(
                                    alert.ResolvedBy))
                                {
                                    <span>
                                        · Resolved by:
                                        @alert.ResolvedBy
                                    </span>
                                }

                                @if (
                                    alert.ResolvedAt.HasValue)
                                {
                                    <span>
                                        · Resolved:
                                        @alert.ResolvedAt
                                    </span>
                                }

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                alert.ResolutionNote))
                            {
                                <div class="record-notice record-notice-neutral"
                                     style="margin-top: 10px;">

                                    <strong>
                                        Resolution
                                    </strong>

                                    <span>
                                        @alert.ResolutionNote
                                    </span>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         FOOTER ACTIONS
    ========================================================== -->

    <div class="record-view-actions"
         style="justify-content: space-between; margin-top: 20px;">

        <a asp-page="./Index"
           class="btn eps-btn-secondary">

            ← Back to Questionnaire

        </a>


        <a href="#"
           class="btn eps-btn-secondary">

            ↑ Back to Top

        </a>

    </div>

</div>


@functions
{
    private static string Display(object? value)
    {
        if (value == null)
        {
            return "—";
        }

        var text =
            Convert.ToString(value);

        return string.IsNullOrWhiteSpace(text)
            ? "—"
            : text;
    }

    private static string DisplayDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        value = value.Trim();

        var acceptedFormats = new[]
        {
            "yyyy-MM-dd",
            "dd/MM/yyyy",
            "d/M/yyyy",
            "MM/dd/yyyy",
            "M/d/yyyy",
            "dd-MM-yyyy",
            "d-M-yyyy",
            "MM-dd-yyyy",
            "M-d-yyyy",
            "dd MMM yyyy",
            "d MMM yyyy",
            "dd-MMM-yyyy",
            "d-MMM-yyyy",
            "yyyy/MM/dd"
        };

        if (DateTime.TryParseExact(
            value,
            acceptedFormats,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var parsedDate))
        {
            return parsedDate.ToString(
                "dd/MM/yyyy",
                System.Globalization.CultureInfo.InvariantCulture);
        }

        return value;
    }

    private static string DisplayTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        value = value.Trim();

        if (TimeSpan.TryParseExact(
            value,
            new[] { @"hh\:mm", @"h\:mm" },
            System.Globalization.CultureInfo.InvariantCulture,
            out var parsedTime))
        {
            return parsedTime.ToString(
                @"hh\:mm",
                System.Globalization.CultureInfo.InvariantCulture);
        }

        return value;
    }
}