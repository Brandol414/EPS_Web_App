                <span>Diarrhea Duration</span>
                <strong>@Display(Model.Record.DiarrheaDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Maximum Loose Stools — 24 Hours</span>
                <strong>@Display(Model.Record.MaxLooseStools24h)</strong>
            </div>

            <div class="record-info-item">
                <span>Loose Stools — 8 Hours</span>
                <strong>@Display(Model.Record.LooseStools8h)</strong>
            </div>

            <div class="record-info-item">
