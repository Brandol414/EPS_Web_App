            </div>

            <div class="record-info-item">
                <span>Painful Straining Severity</span>
                <strong>@Display(Model.Record.PainfulStrainingSeverity)</strong>
            </div>

            <div class="record-info-item">
                <span>Malaise / Fatigue</span>
                <strong>@Display(Model.Record.MalaiseFatigue)</strong>
            </div>

            <div class="record-info-item">
                <span>Malaise / Fatigue Duration</span>
                <strong>@Display(Model.Record.MalaiseFatigueDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Malaise / Fatigue Severity</span>
                <strong>@Display(Model.Record.MalaiseFatigueSeverity)</strong>
            </div>

            <div class="record-info-item">
                <span>Vomiting</span>
                <strong>@Display(Model.Record.Vomiting)</strong>
            </div>

            <div class="record-info-item">
                <span>Vomiting Duration</span>
                <strong>@Display(Model.Record.VomitingDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Number of Vomits</span>
                <strong>@Display(Model.Record.VomitingCount)</strong>
            </div>

            <div class="record-info-item">
                <span>Vomiting Severity</span>
                <strong>@Display(Model.Record.VomitingSeverity)</strong>
            </div>

            <div class="record-info-item">
                <span>Headache</span>
                <strong>@Display(Model.Record.Headache)</strong>
            </div>

            <div class="record-info-item">
                <span>Headache Duration</span>
                <strong>@Display(Model.Record.HeadacheDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Headache Severity</span>
                <strong>@Display(Model.Record.HeadacheSeverity)</strong>
            </div>

            <div class="record-info-item">
                <span>Loss of Appetite</span>
                <strong>@Display(Model.Record.LossOfAppetite)</strong>
            </div>

            <div class="record-info-item">
