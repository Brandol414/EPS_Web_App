@page "{id:long}"
@model global::EPS_Web_App.Pages.Questionnaire.ViewModel

@{
    ViewData["Title"] = "Questionnaire Record";
}


@if (Model.Record == null)
{
    <div class="questionnaire-view-page">

        <div class="module-empty-state">

            <div class="module-empty-icon">
                Q
            </div>

            <h3>
                Questionnaire record not found
            </h3>

            <p>
                The requested questionnaire record could not be located.
            </p>

            <a asp-page="./Index"
               class="btn eps-btn-secondary">
                ← Back to Questionnaire
            </a>

        </div>

    </div>

    return;
}


<div class="questionnaire-view-page">

    <!-- =========================================================
     HEADER
========================================================== -->

    <div class="record-view-header">

        <div>

            <div class="module-eyebrow">
                QUESTIONNAIRE RECORD
            </div>

            <h1 class="record-view-title">
                @Model.Record.SpecimenId
            </h1>

            <div class="record-view-meta">

                <span>
                    Questionnaire ID:
                    @Model.Record.QuestionnaireId
                </span>

                <span class="record-meta-divider">
                    |
                </span>

                <span>
                    Site:
                    @(string.IsNullOrWhiteSpace(Model.Record.SiteCode)
                        ? "—"
                        : Model.Record.SiteCode)
                </span>

                <span class="record-meta-divider">
                    |
                </span>

                <span>
                    LAN:
                    @(string.IsNullOrWhiteSpace(Model.Record.Lan)
                        ? "—"
                        : Model.Record.Lan)
                </span>

            </div>

        </div>


        <!-- =====================================================
         ACTIONS
    ====================================================== -->

        <div class="record-view-actions">

            @if (User.IsInRole("Administrator"))
            {
                <a asp-page="./Edit"
                   asp-route-id="@Model.Record.QuestionnaireId"
                   class="btn eps-btn-primary">

                    Edit Record

                </a>
            }


            <a asp-page="./Index"
               class="btn eps-btn-secondary">

                ← Back to Questionnaire

            </a>

        </div>

    </div>


    <!-- =========================================================
         RECORD IDENTITY / SUMMARY
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    RECORD SUMMARY
                </div>

                <h2>
                    Surveillance Record
                </h2>

            </div>

        </div>


        <div class="record-info-grid">


            <div class="record-info-item">

                <span>
                    Specimen ID
                </span>

                <strong class="identifier-text">
                    @(string.IsNullOrWhiteSpace(Model.Record.SpecimenId)
                        ? "—"
                        : Model.Record.SpecimenId)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Site Code
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Record.SiteCode)
                        ? "—"
                        : Model.Record.SiteCode)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    LAN
                </span>

                <strong class="identifier-text">
                    @(string.IsNullOrWhiteSpace(Model.Record.Lan)
                        ? "—"
                        : Model.Record.Lan)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Isolation Date
                </span>

                <strong>
                    @DisplayDate(Model.Record.IsolationDate)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Age
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Record.Age)
                        ? "—"
                        : Model.Record.Age)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Gender
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Record.Gender)
                        ? "—"
                        : Model.Record.Gender)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Admission Status
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Record.Admitted)
                        ? "—"
                        : Model.Record.Admitted)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Disposition
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Record.Disposition)
                        ? "—"
                        : Model.Record.Disposition)
                </strong>

            </div>

        </div>

    </section>


    <!-- =========================================================
         SECTION 01 — RECORD IDENTITY
    ========================================================== -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SECTION 01
                </div>

                <h2>
                    Record Identity
                </h2>

            </div>

        </div>


        <div class="record-info-grid">


            <div class="record-info-item">

                <span>
                    Specimen ID
                </span>

                <strong class="identifier-text">
                    @Display(Model.Record.SpecimenId)
                </strong>

            </div>


            <div class="record-info-item">

                <span>
                    Site Code
                </span>

                <strong>
