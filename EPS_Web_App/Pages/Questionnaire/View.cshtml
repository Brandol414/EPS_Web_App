            <div class="record-info-item">
                <span>Abdominal Cramps</span>
                <strong>@Display(Model.Record.AbdominalCramps)</strong>
            </div>

            <div class="record-info-item">
                <span>Abdominal Cramps Duration</span>
                <strong>@Display(Model.Record.AbdominalCrampsDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Abdominal Cramps Severity</span>
