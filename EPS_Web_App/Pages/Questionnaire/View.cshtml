                <strong>@Display(Model.Record.StoolUrgency)</strong>
            </div>

            <div class="record-info-item">
                <span>Stool Urgency Duration</span>
                <strong>@Display(Model.Record.StoolUrgencyDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Stool Urgency Severity</span>
                <strong>@Display(Model.Record.StoolUrgencySeverity)</strong>
            </div>

            <div class="record-info-item">
                <span>Muscle Aches</span>
                <strong>@Display(Model.Record.MuscleAches)</strong>
            </div>

            <div class="record-info-item">
                <span>Muscle Aches Duration</span>
                <strong>@Display(Model.Record.MuscleAchesDuration)</strong>
            </div>

            <div class="record-info-item">
                <span>Muscle Aches Severity</span>
                <strong>@Display(Model.Record.MuscleAchesSeverity)</strong>
            </div>

            <div class="record-info-item">
