            <div class="record-info-item">
                <span>Rotavirus Dose 2 Date</span>
                <strong>@DisplayDate(Model.Record.RotavirusDose2Date)</strong>
            </div>

            <div class="record-info-item">
                <span>Other Rotavirus Vaccine</span>
