@page
@model EPS_Web_App.Pages.Diagnostics.DatabaseModel

@{
    ViewData["Title"] = "Database Diagnostics";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="display-6">Database Diagnostics</h1>
        <p class="text-muted">
            EPS Enteric Surveillance application connectivity check.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="card-title">
                SQL Server Status
            </h5>

            <p class="mt-3">
                <strong>Status:</strong>
                @Model.StatusMessage
            </p>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <div class="border rounded p-3">

                        <div class="text-muted">
                            Questionnaire Records
                        </div>

                        <div class="display-6">
                            @Model.QuestionnaireCount.ToString("N0")
                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded p-3">

                        <div class="text-muted">
                            AST Records
                        </div>

                        <div class="display-6">
                            @Model.AstCount.ToString("N0")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>