@page
@model EPS_Web_App.Pages.AST.CreateModel

@{
    ViewData["Title"] = "New AST Record";
}

<div class="questionnaire-create-page">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="create-header">

        <div>

            <div class="module-eyebrow">
                AST LABORATORY DATA ENTRY
            </div>

            <h1 class="module-title">
                New AST Record
            </h1>

            <p class="module-description">
                Enter antimicrobial susceptibility testing results
                and associate the laboratory record with an EPS specimen.
            </p>

        </div>


        <div>

            <a asp-page="./Index"
               class="btn eps-btn-secondary">

                ← Back to AST Laboratory

            </a>

        </div>

    </div>


    <!-- ======================================================
         VALIDATION
    ======================================================= -->

    <div asp-validation-summary="All"
         class="validation-summary">
    </div>


    <form method="post"
          id="astForm">


        <!-- ==================================================
             SECTION 01 — SPECIMEN IDENTITY
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    01
                </div>

                <div>

                    <div class="entry-section-kicker">
                        SPECIMEN
                    </div>

                    <h2>
                        Specimen & Laboratory Identity
                    </h2>

                    <p>
                        Identify the laboratory specimen and its
                        surveillance site.
                    </p>

                </div>

            </div>


            <div class="entry-grid entry-grid-3">


                <!-- SPECIMEN ID -->

                <div class="entry-field entry-field-wide">

                    <label asp-for="Input.SpecimenId">

                        Specimen ID

                        <span class="required-mark">*</span>

                    </label>


                    <input asp-for="Input.SpecimenId"
                           class="form-control"
                           placeholder="EPS1549-KCH-9998A"
                           autocomplete="off" />


                    <span asp-validation-for="Input.SpecimenId"
                          class="text-danger">
                    </span>


                    <div class="field-help">
                        Format: EPS1549-SITE-####A/B
                    </div>

                </div>


                <!-- LAN -->

                <div class="entry-field">

                    <label asp-for="Input.Lan">

                        LAN

                    </label>


                    <input asp-for="Input.Lan"
                           class="form-control"
                           placeholder="MHK#####"
                           autocomplete="off" />


                    <span asp-validation-for="Input.Lan"
                          class="text-danger">
                    </span>

                </div>


                <!-- SITE -->

                <div class="entry-field">

                    <label asp-for="Input.SiteCode">

                        Site Code

                    </label>


                    <input asp-for="Input.SiteCode"
                           class="form-control"
                           placeholder="KCH"
                           autocomplete="off" />


                    <span asp-validation-for="Input.SiteCode"
                          class="text-danger">
                    </span>


                    <div class="field-help">
                        Automatically derived from the specimen ID if left blank.
                    </div>

                </div>


                <!-- MONTH -->

                <div class="entry-field">

                    <label asp-for="Input.MonthCollected">

                        Month Collected

                    </label>


                    <input asp-for="Input.MonthCollected"
                           type="month"
                           class="form-control" />


                    <div class="field-help">
                        Select the month the specimen was collected.
                    </div>


                    <span asp-validation-for="Input.MonthCollected"
                          class="text-danger">
                    </span>

                </div>


                <!-- PARTICIPANT -->

                <div class="entry-field">

                    <label asp-for="Input.ParticipantType">

                        Participant Type

                    </label>


                    <select asp-for="Input.ParticipantType"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Civilian">
                            Civilian
                        </option>

                        <option value="Military">
                            Military
                        </option>

                    </select>

                </div>


                <!-- DIAGNOSTIC TEST -->

                <div class="entry-field">

                    <label asp-for="Input.DiagnosticTest">

                        Diagnostic Test

                    </label>


                    <input asp-for="Input.DiagnosticTest"
                           class="form-control"
                           placeholder="e.g. Culture / AST" />

                </div>

            </div>

        </section>


        <!-- ==================================================
             SECTION 02 — CLINICAL / TREATMENT CONTEXT
        =================================================== -->

        <section class="entry-section">

            <div class="entry-section-header">

                <div class="entry-section-number">
                    02
                </div>

                <div>

                    <div class="entry-section-kicker">
                        CLINICAL CONTEXT
                    </div>

                    <h2>
                        Clinical & Treatment Context
                    </h2>

                    <p>
                        Additional information associated with
                        the laboratory record.
                    </p>

                </div>

            </div>


            <div class="entry-grid entry-grid-3">


                <!-- GTD -->

                <div class="entry-field">

                    <label asp-for="Input.GtdStatus">

                        GTD Status

                    </label>


                    <select asp-for="Input.GtdStatus"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <!-- DIARRHEA MEDICATION -->

                <div class="entry-field">

                    <label asp-for="Input.DiarrheaMedicationPast72h">

                        Diarrhea Medication — Past 72 Hours

                    </label>


                    <select asp-for="Input.DiarrheaMedicationPast72h"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Yes">
                            Yes
                        </option>

                        <option value="No">
                            No
                        </option>

                    </select>

                </div>


                <!-- MEDICATIONS -->

                <div class="entry-field">

                    <label asp-for="Input.MedicationsPast72h">

                        Medications — Past 72 Hours

                    </label>


                    <textarea asp-for="Input.MedicationsPast72h"
                              class="form-control"
                              rows="3"
                              placeholder="List medications where applicable"></textarea>

                </div>


                <!-- FUNCTIONAL IMPACT -->

                <div class="entry-field">

                    <label asp-for="Input.IllnessFunctionalImpact">

                        Illness Functional Impact

                    </label>


                    <select asp-for="Input.IllnessFunctionalImpact"
                            class="form-select">

                        <option value="">
                            Select
                        </option>

                        <option value="Normal">
                            Normal
                        </option>

                        <option value="Decreased <= 50%">
                            Decreased <= 50%
                        </option>

                        <option value="Decreased > 50%">
                            Decreased > 50%
                        </option>

                        <option value="Completely unable to function">
                            Completely unable to function
                        </option>

                    </select>

                </div>

            </div>

        </section>


