@page "{id:long}"
@model EPS_Web_App.Pages.AST.ViewModel

@{
    ViewData["Title"] = "AST Record";


    string Display(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "—"
            : value;
    }


    // =========================================================
    // PRE-FORMATTED DATE VALUES
    //
    // Calculate these before the HTML is rendered so Razor does
    // not interpret chained date methods as page content.
    // =========================================================

    var createdText =
        Model.Record != null
            ? Model.Record.CreatedAt
                .ToLocalTime()
                .ToString("dd MMM yyyy HH:mm")
            : string.Empty;


    var updatedText =
        Model.Record?.UpdatedAt.HasValue == true
            ? Model.Record.UpdatedAt.Value
                .ToLocalTime()
                .ToString("dd MMM yyyy HH:mm")
            : "—";
}


@if (Model.Record == null)
{
    <div class="questionnaire-view-page">

        <div class="module-empty-state">

            <div class="module-empty-icon">
                A
            </div>

            <h3>
                AST record not found
            </h3>

            <p>
                The requested antimicrobial susceptibility
                record could not be located.
            </p>

            <a asp-page="./Index"
               class="btn eps-btn-secondary">

                ← Back to AST Laboratory

            </a>

        </div>

    </div>

    return;
}


<div class="questionnaire-view-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="record-view-header">

        <div>

            <div class="module-eyebrow">
                AST LABORATORY RECORD
            </div>

            <h1 class="record-view-title">

                @Display(
                    Model.Record.SpecimenId
                )

            </h1>

            <div class="record-view-meta">

                <span>
                    AST ID:
                    @Model.Record.AstRecordId
                </span>

                <span class="record-meta-divider">
                    |
                </span>

                <span>
                    Site:
                    @Display(
                        Model.Record.SiteCode
                    )
                </span>

                <span class="record-meta-divider">
                    |
                </span>

                <span>
                    LAN:
                    @Display(
                        Model.Record.Lan
                    )
                </span>

            </div>

        </div>


        <div class="record-view-actions">

            @if (User.IsInRole("Administrator"))
            {
                <a asp-page="./Edit"
                   asp-route-id="@Model.Id"
                   class="btn eps-btn-primary">

                    Edit Record

                </a>
            }


            <a asp-page="./Index"
               class="btn eps-btn-secondary">

                ← Back to AST Laboratory

            </a>

        </div>

    </div>


    <!-- ======================================================
         STATUS BANNER
    ======================================================= -->
    @if (Model.IsLinked)
    {
        <div class="record-notice record-notice-neutral">

            <strong>
                Specimen linked to Questionnaire
            </strong>

            <span>
                This AST record is linked to the questionnaire
                record for specimen

                <strong>
                    @Display(
                        Model.Record.SpecimenId
                    )
                </strong>.

            </span>

        </div>
    }
    else
    {
        <div class="record-notice record-notice-neutral">

            <strong>
                Specimen not linked
            </strong>

            <span>
                This AST record is currently marked as

                <strong>
                    @Display(
                        Model.Record.LinkageStatus
                    )
                </strong>

                and may require reconciliation.

            </span>

        </div>
    }


