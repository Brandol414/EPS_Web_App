    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    SURVEILLANCE LINKAGE
                </div>

                <h2>
                    Questionnaire Record
                </h2>

            </div>

        </div>


        @if (Model.QuestionnaireRecord != null)
        {
            <div class="record-info-grid">


                <div class="record-info-item">

                    <span>
                        Questionnaire ID
                    </span>

                    <strong>
                        @Model.QuestionnaireRecord.QuestionnaireId
                    </strong>

                </div>


                <div class="record-info-item">

                    <span>
                        Specimen ID
                    </span>

                    <strong class="identifier-text">

                        @Display(
                            Model.QuestionnaireRecord.SpecimenId
                        )

                    </strong>

                </div>


                <div class="record-info-item">

                    <span>
                        Site
                    </span>

                    <strong>

                        @Display(
                            Model.QuestionnaireRecord.SiteCode
                        )

                    </strong>

                </div>


                <div class="record-info-item">

                    <span>
                        LAN
                    </span>

                    <strong>

                        @Display(
                            Model.QuestionnaireRecord.Lan
                        )

                    </strong>

                </div>


                <div class="record-info-item">

                    <span>
                        Bacterial Identification
                    </span>

                    <strong>

                        @Display(
                            Model.QuestionnaireRecord.BacterialIdentification
                        )

                    </strong>

                </div>


                <div class="record-info-item">

                    <span>
                        Viral Identification
                    </span>

                    <strong>

                        @Display(
                            Model.QuestionnaireRecord.ViralIdentification
                        )

                    </strong>

                </div>


            </div>


            <div style="margin-top:18px;">

                <a href="/Questionnaire/View/@Model.QuestionnaireRecord.QuestionnaireId"
                   class="btn eps-btn-secondary">

                    Open Questionnaire Record →

                </a>

            </div>
        }
        else
        {
            <div class="record-notice record-notice-neutral">

                <strong>
                    No questionnaire record found
                </strong>

                <span>

                    No questionnaire entry currently exists for
                    specimen

                    <strong>
                        @Display(
                            Model.Record.SpecimenId
                        )
                    </strong>.

                    This AST record can therefore remain unlinked
                    for reconciliation.

                </span>

            </div>
        }

    </section>


    <!-- ======================================================
         SECTION 07 — ADMINISTRATIVE AUDIT HISTORY
    ======================================================= -->

    <section class="record-section">

        <div class="record-section-heading">

            <div>

                <div class="record-section-kicker">
                    ADMINISTRATIVE AUDIT
                </div>

                <h2>
                    Edit History
                </h2>

                <p>
                    A read-only history of administrative corrections
                    made to this AST record.
                </p>

            </div>

        </div>


        @if (Model.AuditHistory.Count == 0)
        {
            <div class="record-notice record-notice-neutral">

                <strong>
                    No administrative edits
                </strong>

                <span>
                    No correction history has been recorded
                    for this AST record.
                </span>

            </div>
        }
        else
        {
            <div class="record-subtable">

                <div class="record-subtable-header">

                    <div>
                        Field
                    </div>

                    <div>
                        Previous Value
                    </div>

                    <div>
                        New Value
                    </div>

                </div>


                @foreach (
                    var audit
                    in Model.AuditHistory)
                {
                    var auditChangedText =
                        audit.ChangedAt
                            .ToLocalTime()
                            .ToString(
                                "dd MMM yyyy HH:mm");


                    <div class="record-subtable-row">

                        <div>

                            <strong>

                                @(string.IsNullOrWhiteSpace(
                                    audit.FieldName)
                                    ? "Record"
                                    : audit.FieldName)

                            </strong>


                            <div class="record-secondary"
                                 style="margin-top:5px;">

                                @auditChangedText

                                <br />

                                By:
                                @audit.ChangedBy

                            </div>

                        </div>


                        <div style="
                            white-space:normal;
                            word-break:break-word;">

                            @(string.IsNullOrWhiteSpace(
                                audit.OldValue)
                                ? "(blank)"
                                : audit.OldValue)

                        </div>


                        <div style="
                            white-space:normal;
                            word-break:break-word;">

                            @(string.IsNullOrWhiteSpace(
                                audit.NewValue)
                                ? "(blank)"
                                : audit.NewValue)

                        </div>

                    </div>


                    <div style="
                        padding:10px 14px;
                        border-bottom:1px solid var(--eps-border);
                        background:var(--eps-panel-soft);">

                        <div class="record-secondary">
                            REASON FOR EDIT
                        </div>

                        <div style="
                            margin-top:3px;
                            font-size:11px;
                            color:var(--eps-text);
                            white-space:normal;
                            word-break:break-word;">

                            @(string.IsNullOrWhiteSpace(
                                audit.Reason)
                                ? "—"
                                : audit.Reason)

                        </div>

                    </div>
                }

            </div>
        }

    </section>


    <!-- ======================================================
         FOOTER ACTIONS
    ======================================================= -->

    <div class="record-view-footer">

        <a asp-page="./Index"
           class="btn eps-btn-secondary">

            ← Back to AST Laboratory

        </a>


        @if (User.IsInRole("Administrator"))
        {
            <a asp-page="./Edit"
               asp-route-id="@Model.Id"
               class="btn eps-btn-primary">

                Edit Record

            </a>
        }

    </div>

</div>