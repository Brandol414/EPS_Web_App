@page
@model EPS_Web_App.Pages.Administration.Lookups.IndexModel

@{
    ViewData["Title"] = "Lookup Management";
}

<div class="questionnaire-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="module-header">

        <div>

            <div class="module-eyebrow">
                SYSTEM CONFIGURATION
            </div>

            <h1 class="module-title">
                Lookup Management
            </h1>

            <p class="module-description">
                Manage controlled lookup values used throughout
                the surveillance application.
            </p>

        </div>


        <div class="module-header-actions">

            <a asp-page="./Create"
               class="btn eps-btn-primary">

                + New Lookup Value

            </a>


            <a asp-page="../Index"
               class="btn eps-btn-secondary">

                ← Administration

            </a>

        </div>

    </div>


    <!-- ======================================================
         SEARCH / FILTER
    ======================================================= -->

    <div class="module-search-panel">

        <form method="get">

            <div class="search-row">


                <div class="search-field search-field-wide">

                    <label for="search">
                        Search
                    </label>

                    <input id="search"
                           name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Group, code, or label..." />

                </div>


                <div class="search-field">

                    <label for="lookupGroup">
                        Lookup Group
                    </label>

                    <select id="lookupGroup"
                            name="lookupGroup"
                            class="form-select">

                        <option value="">
                            All groups
                        </option>

                        @foreach (
                            var group
                            in Model.AvailableGroups)
                        {
                            if (
                                string.Equals(
                                    Model.LookupGroup,
                                    group,
                                    StringComparison.OrdinalIgnoreCase)
                            )
                            {
                                <option value="@group"
                                        selected>
                                    @group
                                </option>
                            }
                            else
                            {
                                <option value="@group">
                                    @group
                                </option>
                            }
                        }

                    </select>

                </div>


                <div class="search-field">

                    <label for="status">
                        Status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        @if (string.IsNullOrWhiteSpace(
                            Model.Status))
                        {
                            <option value=""
                                    selected>
                                All statuses
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All statuses
                            </option>
                        }


                        @if (
                            string.Equals(
                                Model.Status,
                                "Active",
                                StringComparison.OrdinalIgnoreCase)
                        )
                        {
                            <option value="Active"
                                    selected>
                                Active
                            </option>
                        }
                        else
                        {
                            <option value="Active">
                                Active
                            </option>
                        }


                        @if (
                            string.Equals(
                                Model.Status,
                                "Inactive",
                                StringComparison.OrdinalIgnoreCase)
                        )
                        {
                            <option value="Inactive"
                                    selected>
                                Inactive
                            </option>
                        }
                        else
                        {
                            <option value="Inactive">
                                Inactive
                            </option>
                        }

                    </select>

                </div>


                <div class="search-actions">

                    <button type="submit"
                            class="btn eps-btn-primary">

                        Search

                    </button>


                    <a asp-page="./Index"
                       class="btn eps-btn-secondary">

                        Clear

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- ======================================================
         RESULTS HEADER
    ======================================================= -->

    <div class="results-header">

        <div>

            <strong>
                Lookup Values
            </strong>

            <span>
                @Model.TotalItems.ToString("N0")
                matching values
            </span>

        </div>


        <div>

            Page
            @Model.PageNumber
            of
            @(Model.TotalPages == 0
                ? 1
                : Model.TotalPages)

        </div>

    </div>


    <!-- ======================================================
         TABLE
    ======================================================= -->

    <div class="module-table-card">

        @if (Model.Records.Count == 0)
        {
            <div class="module-empty-state">

                <div class="module-empty-icon">
                    L
                </div>

                <h3>
                    No lookup values found
                </h3>

                <p>
                    No lookup values match the current
                    filters.
                </p>

                <a asp-page="./Create"
                   class="btn eps-btn-primary">

                    + Create Lookup Value

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="
                    table
                    table-hover
                    align-middle
                    mb-0">

                    <thead>

                        <tr>

                            <th>
                                Group
                            </th>

                            <th>
                                Code
                            </th>

                            <th>
                                Label
                            </th>

                            <th>
                                Display Order
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var record
                            in Model.Records)
                        {
                            <tr>


                                <td>

                                    <div class="record-primary">

                                        @record.LookupGroup

                                    </div>

                                </td>


                                <td>

                                    <span class="
                                        identifier-chip">

                                        @record.LookupCode

                                    </span>

                                </td>


                                <td>

                                    <div class="record-primary">

                                        @record.LookupLabel

                                    </div>

                                </td>


                                <td>

                                    @(record.DisplayOrder?.ToString()
                                      ?? "—")

                                </td>


                                <td>

                                    @if (record.IsActive)
                                    {
                                        <span class="
                                            identifier-chip
                                            ast-linkage-linked">

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="
                                            identifier-chip
                                            ast-linkage-unlinked">

                                            Inactive

                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <div style="
                                        display:flex;
                                        justify-content:flex-end;
                                        gap:8px;
                                        flex-wrap:wrap;
                                        ">


                                        <a asp-page="./Edit"
                                           asp-route-id="@record.LookupId"
                                           class="
                                            btn
                                            btn-sm
                                            eps-btn-view">

                                            Edit

                                        </a>


                                        @if (record.IsActive)
                                        {
                                            <form method="post"
                                                  asp-page-handler="Deactivate"
                                                  style="margin:0;">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@record.LookupId" />

                                                <button type="submit"
                                                        class="
                                                    btn
                                                    btn-sm
                                                    eps-btn-secondary">

                                                    Deactivate

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post"
                                                  asp-page-handler="Activate"
                                                  style="margin:0;">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@record.LookupId" />

                                                <button type="submit"
                                                        class="
                                                    btn
                                                    btn-sm
                                                    eps-btn-primary">

                                                    Activate

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        <!-- ==================================================
             PAGINATION
        =================================================== -->
        @if (Model.TotalPages > 1)
        {
            <div class="module-pagination">

                <div class="pagination-info">

                    Page
                    @Model.PageNumber
                    of
                    @Model.TotalPages

                </div>


                <div class="pagination-actions">


                    @if (Model.PageNumber > 1)
                    {
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-lookupGroup="@Model.LookupGroup"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           class="btn eps-btn-secondary">

                            ← Previous

                        </a>
                    }


                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-lookupGroup="@Model.LookupGroup"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           class="btn eps-btn-primary">

                            Next →

                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>