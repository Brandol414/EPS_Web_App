@page
@model EPS_Web_App.Pages.Account.LogoutModel

@{
    ViewData["Title"] = "Sign Out";
}

<div class="account-page">

    <div class="account-card">

        <div class="module-eyebrow">
            EPS ENTERIC SURVEILLANCE
        </div>

        <h1 class="account-title">
            Sign Out
        </h1>

        <p class="account-description">
            Are you sure you want to sign out?
        </p>

        <form method="post">

            <button type="submit"
                    class="btn eps-btn-primary account-submit">

                Sign Out

            </button>

        </form>

    </div>

</div>